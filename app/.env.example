# Skill Vault App — runtime configuration
#
# Copy to `.env` and uncomment the values you want to override. `.env`
# is gitignored, so local customization stays local.
#
# Precedence (highest wins):
#   1. CLI flags        — `npm run dev -- --port 5500 --host 0.0.0.0`
#   2. Process env vars — `PORT=5500 npm run dev`
#   3. This file (.env) — loaded on startup by server/launcher.ts
#   4. `app` block in ~/.skill-vault/config.json (shared with the CLI)
#   5. Built-in defaults

# Port to bind. Default: 5174.
# PORT=5174

# Host to bind. Default: 127.0.0.1 (loopback only).
# Set to 0.0.0.0 to expose to the LAN — only do this on networks you
# trust, since the dashboard can mutate your vault and agent dirs.
# HOST=127.0.0.1

# Open the default browser on startup. 1 = yes, 0 = no. Default: 1.
# OPEN_BROWSER=1

# Node environment. Leave unset for dev. Set to "production" only if
# you ran `npm run build` and want to serve the bundled client.
# NODE_ENV=production
