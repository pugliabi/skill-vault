{
  "name": "skill-vault-app",
  "version": "0.1.0",
  "description": "Standalone web UI for managing a Skill Vault directory",
  "type": "module",
  "bin": {
    "skill-vault-app": "./dist/launcher.js"
  },
  "scripts": {
    "test": "node --import tsx --test \"server/**/*.test.ts\"",
    "dev": "tsx watch --clear-screen=false server/launcher.ts",
    "build:client": "vite build",
    "build:server": "esbuild server/launcher.ts server/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outdir=dist",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/launcher.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "^5.56.2",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "express": "^5.0.1",
    "lucide-react": "^0.453.0",
    "marked": "^12.0.2",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "^3.36.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^7.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=20"
  }
}
